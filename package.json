{
  "name": "Jasenrekisteri-backend",
  "version": "1.0.0",
  "description": "Asteriski ry membership register backend",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.7.0"
  },
  "main": "index.js",
  "repository": "https://github.com/asteriskiry/jasenrekisteri-backend",
  "author": "Maks Turtiainen",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "start": "node index.js",
    "nodemon:start": "nodemon index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:log": "pm2 logs",
    "pm2:restart": "pm2 restart all --update-env",
    "import": "node scripts/import.js",
    "create-user": "node scripts/create-user.js",
    "create-product": "node scripts/create-product.js",
    "create-defaults": "node scripts/create-defaults.js",
    "mass-mailer": "node scripts/mass-mailer.js"
  },
  "dependencies": {
    "@log4js-node/smtp": "^2.0.8",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "crypto-random-string": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-csv": "^5.0.7",
    "generate-password": "^1.7.1",
    "jsonwebtoken": "^9.0.3",
    "log4js": "^6.9.1",
    "minimist": "^1.2.8",
    "moment": "^2.30.1",
    "mongoose": "^9.9.4",
    "nodemailer": "^9.1.1",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prompt": "^1.3.0",
    "shelljs": "^0.10.0",
    "stripe": "^22.6.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "debug": "^4.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
